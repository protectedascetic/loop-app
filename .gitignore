# google-services.json is Android client config (not a secret — the API key is
# restricted by package name + SHA-1). Committed so EAS/Gradle can find it.
GoogleService-Info.plist

# Native projects are generated by `expo prebuild` (CNG). Keep them OUT of git
# so EAS regenerates them from app.json + config plugins on every build —
# otherwise EAS uploads a stale android/ and skips prebuild, dropping
# plugin-added native config (share-intent filter, mic permission, etc.).
/android
/ios
